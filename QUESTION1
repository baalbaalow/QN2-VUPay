package vucourses;

import java.util.Scanner; // Import the Scanner class for user input

public class VUCourses {
    public static void main(String[] args) {
        // Create a Scanner object to read input from the console
        Scanner input = new Scanner(System.in);

        // Prompt the applicant to enter the ModuleCode
        System.out.print("Enter the ModuleCode (BSF, BIT, BCS, or BCE): ");
        String moduleCode = input.next(); // Read the string input

        // Use multi-way if-else logic to return course details
        // .equalsIgnoreCase is used to handle various case inputs (e.g., "bsf" or "BSF")
        if (moduleCode.equalsIgnoreCase("BSF")) {
            System.out.println("Module: BSc. Software Engineering");
            System.out.println("Tuition: 900,000");
        } else if (moduleCode.equalsIgnoreCase("BIT")) {
            System.out.println("Module: BSc. Information Technology");
            System.out.println("Tuition: 750,000");
        } else if (moduleCode.equalsIgnoreCase("BCS")) {
            System.out.println("Module: BSc. Computer Science");
            System.out.println("Tuition: 800,000");
        } else if (moduleCode.equalsIgnoreCase("BCE")) {
            System.out.println("Module: BSc. Computer Engineering");
            System.out.println("Tuition: 950,000");
        } else {
            // Return error message for an invalid code
            System.out.println("Wrong Module Code details");
        }
    }
}
